{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "x-ys-flow",
  "description": "Defines the form's runtime-interpreted screen model.",
  "type": "object",
  "required": ["screens"],
  "properties": {
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
