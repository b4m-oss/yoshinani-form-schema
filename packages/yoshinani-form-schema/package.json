{
  "name": "@b4moss/yoshinani-form-schema",
  "version": "0.5.2",
  "description": "JSON Schema extensions (x-ys-*) for Yoshinani form generators",
  "type": "module",
  "main": "./dist/yoshinani-form-schema.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/yoshinani-form-schema.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "README_ja.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack:check": "node scripts/pack-check.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "json-schema",
    "form",
    "yoshinani",
    "x-ys",
    "schema",
    "validation",
    "layout"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b4m-oss/yoshinani-form-schema.git",
    "directory": "packages/yoshinani-form-schema"
  },
  "bugs": {
    "url": "https://github.com/b4m-oss/yoshinani-form-schema/issues"
  },
  "homepage": "https://github.com/b4m-oss/yoshinani-form-schema#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
}
